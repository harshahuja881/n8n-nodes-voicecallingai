{
  "name": "n8n-nodes-voicecallingai",
  "version": "0.1.0",
  "description": "n8n community node for VoiceCallingAI — place human-sounding AI voice calls",
  "keywords": [
    "n8n-community-node-package",
    "voicecallingai",
    "voice",
    "calling",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://voicecallingai.com",
  "author": {
    "name": "VoiceCallingAI",
    "email": "support@voicecallingai.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshahuja881/n8n-nodes-voicecallingai.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/VoiceCallingAiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/VoiceCallingAi/VoiceCallingAi.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
